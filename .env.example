# Copy this file to .env for local testing with `vercel dev`.
# In production, set these as Environment Variables in the Vercel dashboard instead.

# --- Google service account (see README "Google Cloud setup") ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key.
# Keep the \n characters literally (don't turn them into real line breaks).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyMaterial...\n-----END PRIVATE KEY-----\n"

# --- Sheet locations ---
# Two sheets, same tab name/structure, different spreadsheet IDs.
# The dashboard's HERO / PREMIA buttons switch between them.
GOOGLE_SHEET_ID_HERO=1AbCdEfGhIjKlMnOpQrStUvWxYz-hero-sheet-id
GOOGLE_SHEET_ID_PREMIA=1ZzYyXxWwVvUuTtSsRrQqPpOoNn-premia-sheet-id
# (GOOGLE_SHEET_ID also still works as a fallback for GOOGLE_SHEET_ID_HERO,
# for anyone upgrading from the single-sheet version.)
SHEET_TAB_NAME=VEHICLES_BOT

# --- Dashboard login ---
DASHBOARD_PASSWORD=choose-a-strong-password
# Random secret used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
